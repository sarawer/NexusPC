# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# Spring Boot / Maven
/backend/target/
/backend/.idea/
/backend/uploads/
/backend/*.log

# local IDE and agent files
.idea/
*.iml
/AGENTS.md
/CLAUDE.md

# local logs, archives, and unrelated scratch assets
/dev.log
/src.zip
/compute_contrast.js
/liquid-glass/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
