NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_BKASH_ENABLED=false
NEXT_PUBLIC_STRIPE_ENABLED=false

# Backend values are configured through the shell or hosting provider,
# not committed to source control. For local development, use the
# connection details from Aiven's Connect page.
# DB_URL=jdbc:mysql://<aiven-host>:<aiven-port>/<database>?sslMode=REQUIRED&serverTimezone=UTC
# DB_USERNAME=<aiven-username>
# DB_PASSWORD=<aiven-password>
# JWT_SECRET=
# JWT_EXPIRATION_MS=86400000
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# bKash checkout stays disabled until merchant credentials and the callback URL are configured.
# BKASH_ENABLED=false
# BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
# BKASH_USERNAME=
# BKASH_PASSWORD=
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# BKASH_CALLBACK_URL=https://nexuspc-backend.onrender.com/api/payments/bkash/callback
# FRONTEND_URL=http://localhost:3000
# RESEND_API_KEY=<secret-managed Resend API key>
# RESEND_FROM="NexusPC <no-reply@nexuspc.sarawer.me>"

# One-time initial super-admin bootstrap (set only in backend environment)
# BOOTSTRAP_SUPERADMIN_EMAIL=superadmin@nexuspc.com
# BOOTSTRAP_SUPERADMIN_PASSWORD=<unique-random-password-at-least-8-characters>

# Stripe test-mode checkout. Order totals (BDT) are charged in USD at STRIPE_BDT_PER_USD.
# STRIPE_ENABLED=true
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_BDT_PER_USD=122
# STRIPE_CALLBACK_URL=http://localhost:8080/api/payments/stripe/callback
